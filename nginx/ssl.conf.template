# Enabled by /nginx-entrypoint.sh as conf.d/10-ssl.conf once a cert exists
# (Let's Encrypt at /etc/letsencrypt/live, or a manually-uploaded pair at
# /etc/nginx/manual-certs). Terminates TLS and forwards to the plain-HTTP vhost
# on this same nginx (server_name _) so routing lives in exactly one place.

server {
    listen 443 ssl;
    http2 on;
    server_name ${SSL_DOMAIN};

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache  shared:SSL:10m;

    client_max_body_size 15m;
    include /etc/nginx/domain/realip*.conf;        # CF-Connecting-IP only from Cloudflare's ranges (access mode)

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location / {
        proxy_pass http://127.0.0.1:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Conn-Addr $realip_remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# www → the bare domain (301; 308 keeps POST + body), same as the domain wizard's config
server {
    listen 443 ssl;
    http2 on;
    server_name www.${SSL_DOMAIN};
    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { if ($request_method !~ ^(GET|HEAD)$) { return 308 https://${SSL_DOMAIN}$request_uri; } return 301 https://${SSL_DOMAIN}$request_uri; }
}
server {
    listen 80;
    server_name www.${SSL_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { if ($request_method !~ ^(GET|HEAD)$) { return 308 https://${SSL_DOMAIN}$request_uri; } return 301 https://${SSL_DOMAIN}$request_uri; }
}
