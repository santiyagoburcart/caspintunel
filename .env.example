# ============================================================================
#  caspintunel — environment template. Copy to .env and fill in (install.sh
#  does this for you). .env is git-ignored — NEVER commit real values.
#
#  .env holds infrastructure + secrets only. Everything operational (panels,
#  bots + tokens, bank cards, site name/logo, sync / backup intervals, alerts,
#  requirements…) lives in the database and is edited in the admin panel
#  (/panel/). Variables marked "seed-only" are read once to bootstrap an empty
#  install; after that the admin panel is the only source of truth.
# ============================================================================

# ---- docker compose ----
# Makes plain `docker compose …` on the server use the production setup
# (nginx + built SPAs + gunicorn + daphne). Leave unset on a dev machine to get
# the dev setup (runserver + Vite). Offline installs append :docker-compose.offline.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---- core ----
# used in email subjects and backup file names
PROJECT_NAME=caspintunel
# public domain (TLS cert, allowed hosts, links, DNS tooling)
DOMAIN=aicaspin.ir
# server public IPv4 (monitoring page, DNS tooling, offline hosts)
SERVER_IP=
# compose sets this per service; kept for manual manage.py runs on the host
DJANGO_SETTINGS_MODULE=config.settings.prod
# Django secret — generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
# dev settings only (prod always runs with DEBUG=False)
DEBUG=false
# hosts Django answers for (the domain in the admin panel is added automatically)
ALLOWED_HOSTS=aicaspin.ir,www.aicaspin.ir
# origins allowed to call the API cross-origin
CORS_ALLOWED_ORIGINS=https://aicaspin.ir,https://www.aicaspin.ir
# origins trusted for CSRF (Django admin / session forms)
CSRF_TRUSTED_ORIGINS=https://aicaspin.ir,https://www.aicaspin.ir
# base URL for links in emails (verify / password reset)
PUBLIC_BASE_URL=https://aicaspin.ir
# signed-link lifetimes in seconds (48h verify, 2h reset)
EMAIL_VERIFY_TOKEN_MAX_AGE=172800
PASSWORD_RESET_TOKEN_MAX_AGE=7200
# Telegram Mini App URL (blank = PUBLIC_BASE_URL) and initData max age (s)
MINIAPP_URL=
MINIAPP_INITDATA_MAX_AGE=3600

# ---- encryption key for sensitive DB fields (panel password, bot tokens) ----
# generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# NEVER change it after install — encrypted fields would become unreadable.
FIELD_ENCRYPTION_KEY=

# ---- database (MySQL) ----
DB_NAME=caspintunel
DB_USER=caspintunel
DB_PASSWORD=
# MySQL root password (container init, backups)
DB_ROOT_PASSWORD=
DB_HOST=db
DB_PORT=3306

# ---- redis / celery ----
# cache + Channels layer / Celery broker / Celery results
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- PasarGuard panel client tuning (panels themselves are managed in /panel/) ----
# per-request timeout (s)
PANEL_HTTP_TIMEOUT=15
# how long a panel admin token is cached (s)
PANEL_TOKEN_TTL_SECONDS=82800
# master switch for the periodic service sync (interval is set in the admin panel)
PANEL_SYNC_ENABLED=true
# seed-only (fresh install): first panel row. Blank = add the panel in /panel/
# (recommended). Ignored as soon as any panel exists.
#PANEL_BASE_URL=
#PANEL_ADMIN_USERNAME=
#PANEL_ADMIN_PASSWORD=

# ---- Telegram ----
# fallback proxy for both bots when a bot has none set in the admin panel
TELEGRAM_PROXY_URL=
# seed-only (fresh install): initial bot rows. Blank = set tokens in /panel/ → Bots.
#BOT_SALES_TOKEN=
#BOT_BACKUP_TOKEN=
#BOT_BACKUP_CHAT_ID=

# ---- backups ----
# where mysqldump backups are written inside the containers (bind-mounted ./backups)
BACKUP_DIR=/app/backups
# delete backups older than this many days
BACKUP_RETENTION_DAYS=14

# ---- monitoring ----
# internal URL the "site" health check probes (app server, behind nginx)
HEALTHCHECK_SITE_URL=http://web:8000/api/v1/health/
# filesystem path whose usage the monitoring page reports
RESOURCE_DISK_PATH=/
# seconds a bot heartbeat stays valid before the bot counts as down
BOT_HEARTBEAT_TTL=180

# ---- email (the app hands mail to the local mailserver container) ----
# blank EMAIL_HOST in dev = print emails to the console
EMAIL_HOST=mailserver
EMAIL_PORT=25
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=false
# From: address of app emails
DEFAULT_FROM_EMAIL=no-reply@aicaspin.ir

# ---- outbound SMTP relay (most cloud hosts block port 25) ----
# e.g. Mailgun smtp.mailgun.org / SendGrid smtp.sendgrid.net / SES / Gmail app password.
# After changing: docker compose up -d --force-recreate mailserver  (see docs/email-relay.md)
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=

# ---- TLS ----
# contact for Let's Encrypt expiry notices (scripts/init-letsencrypt.sh)
LETSENCRYPT_EMAIL=

# ---- Cloudflare (optional: `manage.py configure_dns` sets DNS + mail records) ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=aicaspin.ir

# ---- GitHub / self-update (panel "Update" button) ----
# token lets the version check read the private repo (and setup_github.sh create it)
GITHUB_TOKEN=
GITHUB_OWNER=santiyagoburcart
GITHUB_REPO=caspintunel
# public/other repo: a raw VERSION file URL instead of the GitHub API
UPDATE_CHECK_URL=
# file the panel writes to request an update (watched by scripts/watch-update.sh)
UPDATE_SENTINEL_PATH=/app/backups/.update-requested

# ---- phpMyAdmin (tools profile, localhost only) ----
PMA_PORT=8080

# ---- install-time only: first Super Admin (install.sh + first `seed`) ----
# Safe to delete from .env after the first install (the account already exists).
#DJANGO_SUPERUSER_USERNAME=
#DJANGO_SUPERUSER_PASSWORD=
#DJANGO_SUPERUSER_EMAIL=
