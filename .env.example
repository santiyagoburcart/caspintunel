# ============================================================================
#  caspintunel — environment template.  Copy to .env and fill in.
#  .env is git-ignored.  NEVER commit real values.
# ============================================================================

# ---- core ----
PROJECT_NAME=caspintunel
DOMAIN=aicaspin.ir
SERVER_IP=
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=aicaspin.ir,www.aicaspin.ir
# comma-separated origins allowed to call the API (React apps, panel, etc.)
CORS_ALLOWED_ORIGINS=https://aicaspin.ir,https://www.aicaspin.ir
# public base URL used to build links in emails (verify / password reset)
PUBLIC_BASE_URL=https://aicaspin.ir
# signed-link lifetimes, seconds (defaults: 48h verify, 2h reset)
EMAIL_VERIFY_TOKEN_MAX_AGE=172800
PASSWORD_RESET_TOKEN_MAX_AGE=7200

# Telegram Mini App: the HTTPS URL Telegram opens (= the user site; leave blank
# to use PUBLIC_BASE_URL) and how long a signed initData blob stays valid.
MINIAPP_URL=
MINIAPP_INITDATA_MAX_AGE=3600

# ---- encryption for sensitive DB fields (panel password, tokens) ----
# generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ---- database (MySQL) ----
DB_NAME=caspintunel
DB_USER=caspintunel
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=db
DB_PORT=3306

# ---- redis / celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Pasargad panel (PasarGuard API) ----
# LEAVE BLANK. The installer does NOT ask for these — after install, log into the
# site admin panel (/panel/ or /admin/) and enter them under Panel settings.
PANEL_BASE_URL=
PANEL_ADMIN_USERNAME=
PANEL_ADMIN_PASSWORD=
PANEL_HTTP_TIMEOUT=15
PANEL_TOKEN_TTL_SECONDS=82800
PANEL_SYNC_ENABLED=true
PANEL_SYNC_INTERVAL_MINUTES=15
# set the panel group ids to attach to new users via Django admin (Panel.default_group_ids);
# run `python manage.py panel_check` to list available group ids

# ---- Cloudflare (DNS + mail records) ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=aicaspin.ir

# ---- Telegram bots (tokens never in Git) ----
# these seed TelegramConfig rows on first `seed`; afterwards edit in Django admin.
# tokens are stored encrypted in the DB. bots idle until a token is set.
BOT_SALES_TOKEN=
BOT_BACKUP_TOKEN=
BOT_BACKUP_CHAT_ID=
TELEGRAM_PROXY_URL=
# where mysqldump backups are written inside the container (a docker volume)
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14

# ---- monitoring ----
HEALTHCHECK_SITE_URL=http://web:8000/api/v1/health/
RESOURCE_DISK_PATH=/
BOT_HEARTBEAT_TTL=180

# ---- email ---------------------------------------------------------------
# The app hands mail to the local `mailserver` container over the private
# docker network (no auth/TLS needed there). Leave EMAIL_HOST blank in local
# dev to print emails to the console instead. Email is always optional — if
# nothing here works, verification/reset/notification mail is skipped, never
# a crash (and email verification is off by default; toggle it in the panel).
EMAIL_HOST=mailserver
EMAIL_PORT=25
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@aicaspin.ir

# ---- outbound relay (REQUIRED for real delivery) -------------------------
# Almost every cloud host blocks outbound port 25, so the mailserver can't
# reach Gmail/Outlook/etc directly. Point it at an SMTP provider and it will
# relay all outgoing mail through them (STARTTLS + SASL AUTH on port 587).
# Sign up for ONE of these, verify your sending domain, then fill in below:
#
#   Mailgun    host smtp.mailgun.org   user postmaster@mg.<domain>  pass <SMTP password>
#   SendGrid   host smtp.sendgrid.net  user apikey                  pass <API key>
#   Amazon SES host email-smtp.<region>.amazonaws.com  user/pass = SES SMTP credentials
#   Gmail      host smtp.gmail.com     user <you>@gmail.com  pass <16-char App Password>
#              (Gmail: low volume only; From must be your Gmail address)
#
# After filling these in:  docker compose up -d --force-recreate mailserver
# then test:               docker compose exec web python manage.py send_test_email you@example.com
# See docs/email-relay.md for the full walkthrough. Blank = no external delivery.
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=

# neutral contact for Let's Encrypt expiry notices (never the site-admin email)
LETSENCRYPT_EMAIL=

# ---- GitHub (private repo auto-created by scripts/setup_github.sh) ----
GITHUB_TOKEN=
GITHUB_OWNER=santiyagoburcart
GITHUB_REPO=caspintunel

# ---- self-update (panel "Update" button) ----
# private repo: the version check uses the GitHub API + token above.
# public/other: set UPDATE_CHECK_URL to a raw VERSION file instead.
UPDATE_CHECK_URL=
UPDATE_SENTINEL_PATH=/app/backups/.update-requested

# ---- phpMyAdmin ----
PMA_PORT=8080

# ---- superuser bootstrap (used by install.sh only) ----
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
